# ─── Base de Datos SQL Server ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=1433
DB_NAME=mi_base_de_datos
DB_USER=sa
DB_PASSWORD=tu_password_seguro

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=cambia_esto_por_un_secreto_muy_largo_y_seguro
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Firma Digital ED25519 ────────────────────────────────────────────────────
# Rutas a los archivos PEM generados con la utilidad de crypto
ED25519_PRIVATE_KEY_PATH=./keys/private_key.pem
ED25519_PUBLIC_KEY_PATH=./keys/public_key.pem

# ─── Aplicación ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=4050
APP_DEBUG=true
# En local: puerto de Vite (5173). En producción IIS: puerto del sitio (5040)
CORS_ORIGINS=http://localhost:5173,http://localhost:5040
