# ─── Base de Datos SQL Server ────────────────────────────────────────────────
DB_HOST=DESKTOP-EC7M5TG
DB_PORT=1433
DB_NAME=LicenciasDB
DB_USER=sa
DB_PASSWORD=sa

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=JWT_PARA_AND_ANDRES_ALTAMIRANO_85_LICENCIAMIENTOS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Firma Digital ED25519 ────────────────────────────────────────────────────
# Rutas a los archivos PEM generados con la utilidad de crypto
ED25519_PRIVATE_KEY_PATH=./keys/private_key.pem
ED25519_PUBLIC_KEY_PATH=./keys/public_key.pem

# ─── Aplicación ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=4050
APP_DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://localhost:8090
