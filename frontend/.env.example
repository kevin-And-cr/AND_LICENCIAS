# URL completa del API — dejar VACÍO en producción Docker (Nginx hace el proxy internamente).
# Ejemplos:
#   Producción Docker:          VITE_API_URL=
#   Dev sin Docker (directo):   VITE_API_URL=http://localhost:8000/api/v1
#   Servidor cliente 192.x.x:  VITE_API_URL=http://192.168.1.50:8000/api/v1
VITE_API_URL=

# URL del backend para el proxy del servidor de desarrollo Vite (solo en dev).
# Cambiar si el backend corre en otra IP o puerto.
# No afecta la build de producción.
# Puerto del backend FastAPI (4050 en producción, 4050 también en local si se cambió)
VITE_BACKEND_URL=http://localhost:4050
